# Ollama running on the docker host (see README for the OLLAMA_HOST=0.0.0.0 note on Linux)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b          # must support tool calling; `ollama pull` it first
OLLAMA_NUM_CTX=16384

MAX_ITERATIONS=25
COMMAND_TIMEOUT=120

# Sandbox: "none" blocks network (safe, but npm/pip install fail). Use "bridge" to allow it.
SANDBOX_NETWORK=none
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1

# 127.0.0.1 = only reachable from the server itself (use a reverse proxy / SSH tunnel / Tailscale).
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Optional shared secret for the API (nginx injects it for the web UI, CLI reads it from env).
AGENT_API_TOKEN=

# Only needed if you don't run `docker compose` from the repo root:
# HOST_WORKSPACE_DIR=/absolute/path/to/coding-agent/workspace
